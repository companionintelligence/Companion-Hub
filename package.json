{
  "name": "runtipi",
  "version": "4.1.0",
  "description": "",
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env.dev -- turbo run dev",
    "bundle": "turbo bundle",
    "build": "turbo run build",
    "tsc": "turbo run tsc",
    "test": "turbo test",
    "test:integration": "turbo run test:integration",
    "start": "node ./main.js",
    "start:dev": "ENV_FILE=.env.dev docker compose --env-file .env.dev --project-name runtipi -f docker-compose.dev.yml up --build",
    "start:prod": "ENV_FILE=.env.prod docker compose --env-file .env.prod --project-name runtipi -f docker-compose.prod.yml up --build",
    "start:staging": "ENV_FILE=.env.staging CI_CLOUD_API_URL=https://app-staging.ci.computer/api docker compose --env-file .env.staging --project-name runtipi -f docker-compose.prod.yml up --build",
    "cleanup": "bun run scripts/cleanup.ts",
    "test:e2e": "bun scripts/run-e2e.ts",
    "test:e2e:ui": "NODE_ENV=test dotenv -e .env -e .env.e2e -- playwright test --ui",
    "check:all": "bun run lint && turbo run tsc && turbo run build && turbo run test",
    "gen:api-client": "openapi-ts",
    "lint:ci": "biome ci . --error-on-warnings --no-errors-on-unmatched",
    "lint": "biome check",
    "lint:fix": "biome check --write --no-errors-on-unmatched",
    "prepare": "husky",
    "version": "echo $npm_package_version"
  },
  "lint-staged": {
    "*": [
      "bun run lint:fix",
      "git add"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "GNU General Public License v3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.0.4",
    "@hey-api/openapi-ts": "^0.86.11",
    "@playwright/test": "^1.52.0",
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "^1.2.22",
    "@types/pg": "^8.15.1",
    "dotenv-cli": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.5.6"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "drizzle-orm": "^0.44.7",
    "express": "^5.2.1",
    "zod": "^4.1.5"
  },
  "private": true,
  "peerDependencies": {
    "typescript": "^5"
  }
}
