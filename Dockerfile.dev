ARG NODE_VERSION="jod"
ARG ALPINE_VERSION=""
ARG BUN_VERSION="1.3.0"

FROM oven/bun:${BUN_VERSION}-slim AS bun_base
FROM node:${NODE_VERSION}-slim AS node_base

COPY --from=bun_base /usr/local/bin/bun /usr/local/bin/bun

RUN apt-get update && apt-get install -y g++ make curl python3 openssl git docker.io

ARG TARGETARCH
ARG DOCKER_COMPOSE_VERSION="v2.39.2"
ENV TARGETARCH=${TARGETARCH}
ENV NODE_ENV="development"
ENV PATH="/app/node_modules/.bin:$PATH"

WORKDIR /app

RUN echo "Building for ${TARGETARCH}"
RUN if [ "${TARGETARCH}" = "arm64" ]; then \
  curl -L -o docker-binary "https://github.com/docker/compose/releases/download/$DOCKER_COMPOSE_VERSION/docker-compose-linux-aarch64"; \
  elif [ "${TARGETARCH}" = "amd64" ]; then \
  curl -L -o docker-binary "https://github.com/docker/compose/releases/download/$DOCKER_COMPOSE_VERSION/docker-compose-linux-x86_64"; \
  fi

RUN chmod +x docker-binary
RUN mv docker-binary /usr/local/bin/docker-compose

COPY ./package.json ./package.json
COPY ./bun.lock ./
COPY ./packages/backend/package.json ./packages/backend/package.json
COPY ./packages/frontend/package.json ./packages/frontend/package.json
COPY ./packages/common/package.json ./packages/common/package.json
COPY ./packages/frontend/scripts ./packages/frontend/scripts
COPY ./packages/frontend/public ./packages/frontend/public

# Install global tools to ensure availability
RUN npm install -g @nestjs/cli typescript

RUN bun install --frozen-lockfile --verbose

# Fix for broken symlinks in workspaces - remove local binaries to use global or root ones
RUN rm -rf packages/*/node_modules/.bin

COPY ./turbo.json ./turbo.json
COPY ./tsconfig.json ./tsconfig.json
COPY ./packages ./packages
COPY ./packages/backend/assets ./assets
COPY ./packages/backend/src/core/database/drizzle ./assets/migrations

EXPOSE 3000

CMD ["npm", "run", "dev"]
