post_remove() {
    list_home_dirs() {
        getent passwd | awk -F: '($3 == 0 || $3 >= 1000) && $6 ~ /^\// { print $6 }' | awk '!seen[$0]++'
    }

    cleanup_user_home() {
        local home_dir="$1"
        local xdg_data_home="${XDG_DATA_HOME:-$home_dir/.local/share}"
        local xdg_config_home="${XDG_CONFIG_HOME:-$home_dir/.config}"
        local xdg_cache_home="${XDG_CACHE_HOME:-$home_dir/.cache}"

        [ -d "$home_dir" ] || return 0

        case "$xdg_data_home" in "$home_dir"/*) ;; *) xdg_data_home="$home_dir/.local/share" ;; esac
        case "$xdg_config_home" in "$home_dir"/*) ;; *) xdg_config_home="$home_dir/.config" ;; esac
        case "$xdg_cache_home" in "$home_dir"/*) ;; *) xdg_cache_home="$home_dir/.cache" ;; esac

        for name in "Companion Hub" "companion-hub" "ci-hub" "CI-Hub" "computer.ci.app.hub"; do
            rm -rf "$xdg_data_home/$name" >/dev/null 2>&1 || true
            rm -rf "$xdg_config_home/$name" >/dev/null 2>&1 || true
            rm -rf "$xdg_cache_home/$name" >/dev/null 2>&1 || true
        done
    }

    # Echo unique image IDs used by a compose project (pulled or built); call
    # before removing the project's containers so disk can be reclaimed after.
    snapshot_project_images() {
        local project="$1"
        {
            docker ps -a --filter "label=com.docker.compose.project=$project" -q 2>/dev/null |
                while IFS= read -r cid; do [ -n "$cid" ] && docker inspect --format '{{.Image}}' "$cid" 2>/dev/null; done
            docker images --filter "label=com.docker.compose.project=$project" -q 2>/dev/null
        } | awk 'NF && !seen[$0]++'
    }

    remove_images() {
        while IFS= read -r img; do
            [ -n "$img" ] && docker image rm -f "$img" >/dev/null 2>&1 || true
        done
    }

    echo '[cleanup][INFO] Running Companion Hub post-remove cleanup (best effort)'

    if command -v docker >/dev/null 2>&1; then
        # Marketplace apps run as their own compose projects (<app>_<store>); Hub stamps
        # every managed app container with `ci-os-hub.managed=true` (store-agnostic).
        # Tear down each managed project's containers, networks, volumes, and images.
        docker ps -a --filter "label=ci-os-hub.managed=true" \
            --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null | awk 'NF && !seen[$0]++' |
            while IFS= read -r project; do
                [ -n "$project" ] || continue
                project_images="$(snapshot_project_images "$project")"
                docker ps -a --filter "label=com.docker.compose.project=$project" --format '{{.ID}}' 2>/dev/null |
                    while IFS= read -r cid; do [ -n "$cid" ] && docker rm -f "$cid" >/dev/null 2>&1 || true; done
                docker network ls --filter "label=com.docker.compose.project=$project" --format '{{.Name}}' 2>/dev/null |
                    while IFS= read -r net; do
                        case "$net" in
                            ''|bridge|host|none|ci_os_hub_network|ci-os-hub_network) ;;
                            *) docker network rm "$net" >/dev/null 2>&1 || true ;;
                        esac
                    done
                docker volume ls --filter "label=com.docker.compose.project=$project" --format '{{.Name}}' 2>/dev/null |
                    while IFS= read -r vol; do [ -n "$vol" ] && docker volume rm "$vol" >/dev/null 2>&1 || true; done
                printf '%s\n' "$project_images" | remove_images
            done

        hub_images="$({ snapshot_project_images "ci-os-hub"; snapshot_project_images "ci-hub"; } | awk 'NF && !seen[$0]++')"

        {
            docker ps -a --filter "label=com.docker.compose.project=ci-os-hub" --format '{{.Names}}' 2>/dev/null
            docker ps -a --filter "label=com.docker.compose.project=ci-hub" --format '{{.Names}}' 2>/dev/null
            docker ps -a --filter "network=ci_os_hub_network" --format '{{.Names}}' 2>/dev/null
            docker ps -a --filter "network=ci-os-hub_network" --format '{{.Names}}' 2>/dev/null
        } | awk 'NF && !seen[$0]++' | while IFS= read -r name; do
            docker rm -f "$name" >/dev/null 2>&1 || true
        done

        docker network rm ci_os_hub_network ci-os-hub_network >/dev/null 2>&1 || true

        docker volume ls --format '{{.Name}}' 2>/dev/null | while IFS= read -r vol; do
            case "$vol" in
                *ci_os_hub*|*ci-os-hub*|*ci_hub_pgdata*|*ci_hub_app_data*|*hub_tailscale_state*)
                    docker volume rm "$vol" >/dev/null 2>&1 || true
                    ;;
            esac
        done

        printf '%s\n' "$hub_images" | remove_images
    fi

    list_home_dirs | while IFS= read -r home_dir; do
        cleanup_user_home "$home_dir"
    done

    echo '[cleanup][INFO] Companion Hub post-remove cleanup complete'
}
