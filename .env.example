# =============================================================================
# CI-Hub Minimal Environment Configuration
# =============================================================================
# Most values are hardcoded with sensible defaults. Only the variables below
# need to be set. All others can be added to override defaults if needed.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — you must set these
# ---------------------------------------------------------------------------

# Absolute host path for Docker volume mounts (state, repos, apps, logs, etc.)
ROOT_FOLDER_HOST=/path/to/your/data

# Database password (used by both Postgres container and backend)
POSTGRES_PASSWORD=<strong-password>

# Secret for signing JWT auth tokens
JWT_SECRET=<random-secret>

# Host LAN IP for local network access
INTERNAL_IP=0.0.0.0

# Your domain (used for Traefik routing and tunnel config)
DOMAIN=companionintelligence.com

# Local LAN domain for Traefik routing (apps accessible as e.g. jitsi.ci.lan). Defaults to ci.lan.
# LOCAL_DOMAIN=ci.lan

# CI Portal URL (device registration, app store, sync)
CI_CLOUD_URL=https://portal.companionintelligence.com

# ---------------------------------------------------------------------------
# OPTIONAL — have sensible defaults, override if needed
# ---------------------------------------------------------------------------

# NODE_ENV=production          # production | development | staging
# LOCAL=false                  # true to skip HTTPS requirements
# LOG_LEVEL=info               # debug | info | warn | error
# CI_HUB_VERSION=4.5.0        # Reported version
# INTERNAL_IP=127.0.0.1       # Host LAN IP

# EXPERIMENTAL_INSECURE_COOKIE=false  # true for HTTP-only dev setups
# DEVICE_ID=                   # Set during device registration

# Local LAN domain for Traefik routing (apps accessible as e.g. jitsi.ci.lan). Defaults to ci.lan.
# LOCAL_DOMAIN=ci.lan

# --- Build / platform (rarely needed) ---
# DOCKER_PLATFORM=linux/amd64
# TARGETARCH=amd64
# HTTP_PORT=80
# HTTPS_PORT=443

# Private VPN (Headscale + hub-tailscale): enabled by default. Set to false to skip those containers
# (docker compose profile `private-vpn`). `bun scripts/start.ts` and the desktop app set COMPOSE_PROFILES accordingly.
# PRIVATE_VPN_ENABLED=false

# Private VPN: the Hub creates a Headscale pre-auth key and enrolls hub-tailscale automatically
# (stored under state/headscale/). Set HEADSCALE_AUTO_BOOTSTRAP=false only if you must disable that.
# Advanced overrides (rare): HEADSCALE_PREAUTH_KEY for compose TS_AUTHKEY;
# HUB_TAILSCALE_ADVERTISE_ROUTES, HUB_TAILSCALE_LOGIN_SERVER for bootstrap tailscale up.
#
# Public Headscale URL (HTTPS via Traefik): set one of these so Tailscale clients can use your Hub as
# --login-server. The Hub writes Headscale server_url and a Traefik route from this hostname to headscale:8080.
# DNS: point the hostname A/AAAA record at this machine’s public IP; keep ports 80 and 443 open for ACME.
# Examples (override DOMAIN convention if you use a different hostname):
#   HEADSCALE_PUBLIC_HOST=headscale.ci.computer
#   HEADSCALE_PUBLIC_HOST=headscale.companionintel.com
# Optional full URL (origin only is used): HEADSCALE_PUBLIC_URL=https://headscale.ci.computer
# If HEADSCALE_PUBLIC_* is unset, DOMAIN alone selects https://headscale.<DOMAIN> (create DNS for that name).
# Cloudflare tunnel sync uses https://vpn-{device}-{org}.<userSettings.domain> when the hub is registered;
# HEADSCALE_TUNNEL_PORT is the container port for that ingress (default 8080, Headscale listen_addr).
# HEADSCALE_TUNNEL_PORT=8080

# --- Headplane (Headscale admin UI) ---
# Headplane runs alongside Headscale under the `private-vpn` profile and is
# reachable on the LAN at https://headscale-admin.<LOCAL_DOMAIN>. It uses
# Headscale's sqlite DB via the shared /etc/headscale volume.
#
# Required: a stable cookie signing secret (>=32 bytes). Rotate to invalidate
# existing admin sessions.
# HEADPLANE_COOKIE_SECRET=change-me-32-bytes-minimum-please-rotate
#
# Optional: gate the admin UI behind your own OIDC provider (e.g. the Portal's
# better-auth OIDC endpoint or a Cloudflare Access app). Leave unset for
# open-access local dev. If set, mirror the same values under `oidc:` in
# state/headscale/config.yaml so Headscale itself accepts the same identities.
# HEADPLANE_OIDC_ISSUER=
# HEADPLANE_OIDC_CLIENT_ID=
# HEADPLANE_OIDC_CLIENT_SECRET=

# --- All other variables (DB host, RabbitMQ, container names, etc.) ---
# are hardcoded in constants.ts and docker-compose.prod.yml.
# They can still be overridden via env vars for backward compatibility.
