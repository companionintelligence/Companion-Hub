# =============================================================================
# CI-Hub Minimal Environment Configuration
# =============================================================================
# Most values are hardcoded with sensible defaults. Only the variables below
# need to be set. All others can be added to override defaults if needed.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — you must set these
# ---------------------------------------------------------------------------

# Compose env file path (must match a real file — never let Docker create a .env/ directory)
ENV_FILE=.env.dev

# Host docker group GID for socket access when the Hub runs as non-root (init:host sets this)
# DOCKER_GID=973

# Absolute host path for Docker volume mounts (state, repos, apps, logs, etc.)
ROOT_FOLDER_HOST=/path/to/your/data

# Database password (used by both Postgres container and backend)
POSTGRES_PASSWORD=<strong-password>

# Secret for signing JWT auth tokens
JWT_SECRET=<random-secret>

# Host LAN IP for local network access
INTERNAL_IP=0.0.0.0

# Your domain (used for Traefik routing and tunnel config)
DOMAIN=companionintelligence.org

# Local LAN domain for Traefik routing (apps accessible as e.g. jitsi.ci.lan). Defaults to ci.lan.
# LOCAL_DOMAIN=ci.lan

# CI Portal URL (device registration, app store, sync)
CI_CLOUD_URL=https://hub.ci.computer

# Hub version string (required by the backend env validator, even though
# docker-compose injects a default — leave uncommented unless you set it
# via your shell environment).
CI_HUB_VERSION=4.5.0

# ---------------------------------------------------------------------------
# OPTIONAL — have sensible defaults, override if needed
# ---------------------------------------------------------------------------

# NODE_ENV=production          # production | development | staging
# LOCAL=false                  # true to skip HTTPS requirements
# LOG_LEVEL=info               # debug | info | warn | error
# INTERNAL_IP=127.0.0.1       # Host LAN IP

# EXPERIMENTAL_INSECURE_COOKIE=false  # true for HTTP-only dev setups
# DEVICE_ID=                   # Set during device registration

# Local LAN domain for Traefik routing (apps accessible as e.g. jitsi.ci.lan). Defaults to ci.lan.
# LOCAL_DOMAIN=ci.lan

# --- Desktop (Tauri) Hub container image ---
# The bundled Docker Compose uses CI_HUB_IMAGE (default pulls ghcr.io/companionintelligence/ci-hub:dev).
# Building this repo locally does not replace that image until you push or override, e.g.:
# CI_HUB_IMAGE=ci-hub:local
# (after: docker build -t ci-hub:local -f Dockerfile .  from the repo root)

# --- Build / platform (rarely needed) ---
# Hub container runs as this host user (defaults 1000:1000). Set automatically by Tauri/CLI on Linux/macOS.
# CI_HUB_CONTAINER_UID=
# CI_HUB_CONTAINER_GID=
# DOCKER_PLATFORM=linux/amd64
# TARGETARCH=amd64
# HTTP_PORT=80
# HTTPS_PORT=443

# Tailscale sidecar (hub-tailscale): on by default via COMPOSE_PROFILES=private-vpn.
# Opt out explicitly: PRIVATE_VPN_USER_DISABLED=true (then restart the stack).
# Pre-auth key from https://login.tailscale.com/admin/settings/keys
# TAILSCALE_AUTHKEY=tskey-auth-...
# Optional: override `tailscale up` args (default advertises 172.18.0.0/16 for the Docker bridge).
# HUB_TAILSCALE_EXTRA_ARGS=--accept-routes --advertise-routes=172.18.0.0/16
# Legacy env name still supported: HEADSCALE_PREAUTH_KEY (same as TAILSCALE_AUTHKEY).

# --- All other variables (DB host, RabbitMQ, container names, etc.) ---
# are hardcoded in constants.ts and docker-compose.prod.yml.
# They can still be overridden via env vars for backward compatibility.

# Let's Encrypt / ACME registration email written into traefik.yml at startup.
# If unset, a generic placeholder is used (cert issuance still works; expiry
# notifications from Let's Encrypt will be sent to this address if set).
# ACME_EMAIL=you@example.com
