# =============================================================================
# CI-Hub Minimal Environment Configuration
# =============================================================================
# Most values are hardcoded with sensible defaults. Only the variables below
# need to be set. All others can be added to override defaults if needed.
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — you must set these
# ---------------------------------------------------------------------------

# Absolute host path for Docker volume mounts (state, repos, apps, logs, etc.)
ROOT_FOLDER_HOST=/path/to/your/data

# Database password (used by both Postgres container and backend)
POSTGRES_PASSWORD=<strong-password>

# Secret for signing JWT auth tokens
JWT_SECRET=<random-secret>

# Host LAN IP for local network access
INTERNAL_IP=0.0.0.0

# Your domain (used for Traefik routing and tunnel config)
DOMAIN=companionintelligence.com

# ---------------------------------------------------------------------------
# OPTIONAL — have sensible defaults, override if needed
# ---------------------------------------------------------------------------

# NODE_ENV=production          # production | development | staging
# LOCAL=false                  # true to skip HTTPS requirements
# LOG_LEVEL=info               # debug | info | warn | error
# CI_HUB_VERSION=4.5.0        # Reported version
# INTERNAL_IP=127.0.0.1       # Host LAN IP

# EXPERIMENTAL_INSECURE_COOKIE=false  # true for HTTP-only dev setups
# DEVICE_ID=                   # Set during device registration

# CI_CLOUD_URL=https://portal.companionintelligence.com
# CI_CLOUD_API_URL=https://portal.companionintelligence.com/api

# --- Build / platform (rarely needed) ---
# DOCKER_PLATFORM=linux/amd64
# TARGETARCH=amd64
# HTTP_PORT=80
# HTTPS_PORT=443

# --- All other variables (DB host, RabbitMQ, container names, etc.) ---
# are hardcoded in constants.ts and docker-compose.prod.yml.
# They can still be overridden via env vars for backward compatibility.
