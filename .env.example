# Application Configuration
LOG_LEVEL=info
NODE_ENV=production
TIPI_VERSION=4.7.0
LOCAL=false

# Docker Build Arguments (used in docker-compose build args)
DOCKER_PLATFORM=linux/amd64
TARGETARCH=amd64

# Docker Compose Override Variables (used in docker-compose files)
DB_CONTAINER_NAME=ci-hub-db
QUEUE_CONTAINER_NAME=ci-os-hub-queue
HUB_CONTAINER_NAME=ci-os-hub
TRAEFIK_CONTAINER_NAME=traefik
CLOUDFLARED_CONTAINER_NAME=cloudflared
NETWORK_NAME=ci-os-hub_network
DB_VOLUME_NAME=ci_hub_pgdata
ENV_FILE=.env

# Traefik Ports
HTTP_PORT=80
HTTPS_PORT=443

# Paths (used in docker-compose volume mounts)
# ROOT_FOLDER_HOST MUST be an absolute path to the data directory on the host.
# This is used to generate correct Docker volume mounts for installed apps.
# Example: /opt/ci-os-hub/data or /home/user/ci-os-hub/.internal
ROOT_FOLDER_HOST=/path/to/your/data
# RUNTIPI_APP_DATA_PATH is no longer used for the Hub container (now a named volume).
# It is still used for app containers spawned by the Hub.
RUNTIPI_APP_DATA_PATH=/path/to/your/data
RUNTIPI_MEDIA_PATH=.internal
RUNTIPI_STATE_PATH=.internal
RUNTIPI_REPOS_PATH=.internal
RUNTIPI_APPS_PATH=.internal
RUNTIPI_LOGS_PATH=.internal
RUNTIPI_USER_CONFIG_PATH=.internal
RUNTIPI_BACKUPS_PATH=.internal
INTERNAL_IP=0.0.0.0

# CI Cloud Integration
CI_CLOUD_URL=https://portal.companionintelligence.com
CI_CLOUD_API_URL=https://portal.companionintelligence.com/api
CI_CLOUD_FRONTEND_URL=https://portal.companionintelligence.com

# Domain Configuration
DOMAIN=companionintelligence.com
LOCAL_DOMAIN=tipi.lan
DNS_IP=9.9.9.9

# Database Configuration
POSTGRES_HOST=ci-hub-db
POSTGRES_DBNAME=tipi
POSTGRES_USERNAME=tipi
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=6543

# RabbitMQ Configuration
RABBITMQ_HOST=ci-os-hub-queue
RABBITMQ_USERNAME=tipi
RABBITMQ_PASSWORD=tipi

# Traefik Configuration
RUNTIPI_FORWARD_AUTH_URL=http://ci-os-hub:3000/api/auth/traefik

# Application Settings
DEMO_MODE=false
GUEST_DASHBOARD=false
ALLOW_AUTO_THEMES=true
ALLOW_ERROR_MONITORING=false
PERSIST_TRAEFIK_CONFIG=false
QUEUE_TIMEOUT_IN_MINUTES=5
MAX_BACKUPS=0
ADVANCED_SETTINGS=false
EXPERIMENTAL_INSECURE_COOKIE=false
THEME_BASE=gray
THEME_COLOR=blue
DISABLE_PASSWORD_RESET=true

# Security
JWT_SECRET=your-secret-key-here

# Timezone
TZ=UTC

# Architecture
ARCHITECTURE=amd64

# CI Hub (set automatically during device registration, stored in settings.json)
# CI_HUB_API_KEY and CI_HUB_ORGANIZATION_ID are set automatically during registration
# They are stored in settings.json, not environment variables

# Device ID (optional - used in staging/testing, auto-generated if not provided)
DEVICE_ID=
