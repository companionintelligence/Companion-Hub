{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "desktop#build": {
      "dependsOn": ["frontend#build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["SKIP_DESKTOP_BUILD"],
      "outputs": [
        "src-tauri/target/release/bundle/**",
        "src-tauri/target/release/ci-os-hub-desktop",
        "src-tauri/target/release/ci-os-hub-desktop.exe"
      ]
    },
    "mobile#build": {
      "dependsOn": ["frontend#build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["^bundle"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "@ci-hub/common#bundle": {
      "dependsOn": ["@ci-hub/common#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "@ci-hub/openclaw-plugin#bundle": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/hub-plugin.mjs"]
    },
    "desktop#bundle": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "tsc": {
      "dependsOn": ["^tsc"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "FRONTEND_PORT",
        "CI_HUB_EXTRA_CORS_ORIGINS",
        "CI_HUB_DATA_DIR",
        "CI_HUB_APP_DATA_DIR",
        "CI_HUB_APP_DIR",
        "NODE_ENV",
        "LOCAL",
        "ROOT_FOLDER_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "POSTGRES_DBNAME",
        "POSTGRES_USERNAME",
        "RABBITMQ_HOST",
        "RABBITMQ_PORT",
        "RABBITMQ_USERNAME",
        "RABBITMQ_PASSWORD",
        "JWT_SECRET",
        "INTERNAL_IP",
        "CI_HUB_VERSION",
        "LOG_LEVEL",
        "CI_CLOUD_URL",
        "LOCAL_DOMAIN",
        "DOMAIN",
        "APPS_REPO_URL",
        "OLLAMA_URL",
        "VLLM_URL",
        "OMLX_URL",
        "OMLX_API_KEY",
        "LEMONADE_URL"
      ]
    },
    "local": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "FRONTEND_PORT",
        "CI_HUB_EXTRA_CORS_ORIGINS",
        "CI_HUB_DATA_DIR",
        "CI_HUB_APP_DATA_DIR",
        "CI_HUB_APP_DIR",
        "NODE_ENV",
        "LOCAL",
        "ROOT_FOLDER_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "POSTGRES_DBNAME",
        "POSTGRES_USERNAME",
        "RABBITMQ_HOST",
        "RABBITMQ_PORT",
        "RABBITMQ_USERNAME",
        "RABBITMQ_PASSWORD",
        "JWT_SECRET",
        "INTERNAL_IP",
        "CI_HUB_VERSION",
        "LOG_LEVEL",
        "CI_CLOUD_URL",
        "LOCAL_DOMAIN",
        "DOMAIN",
        "APPS_REPO_URL",
        "OLLAMA_URL",
        "VLLM_URL",
        "OMLX_URL",
        "OMLX_API_KEY",
        "LEMONADE_URL"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^test:integration"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/"]
    }
  }
}
