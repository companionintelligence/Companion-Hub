{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "frontend#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
      "env": ["CI_CLOUD_URL", "CI_HUB_VERSION", "CI_HUB_IMAGE", "CI_HUB_ENVIRONMENT"],
      "outputs": ["dist/"]
    },
    "desktop#build": {
      "dependsOn": ["frontend#build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["SKIP_DESKTOP_BUILD", "TAURI_BUNDLE_TARGETS"],
      "outputs": [
        "src-tauri/target/release/bundle/**",
        "src-tauri/target/release/ci-os-hub-desktop",
        "src-tauri/target/release/ci-os-hub-desktop.exe"
      ]
    },
    "mobile#build": {
      "dependsOn": ["frontend#build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "bundle": {
      "dependsOn": ["^bundle"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "frontend#bundle": {
      "dependsOn": ["^bundle"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/.env*"],
      "env": ["CI_CLOUD_URL", "CI_HUB_VERSION", "CI_HUB_IMAGE", "CI_HUB_ENVIRONMENT"],
      "outputs": ["dist/"]
    },
    "@ci-hub/common#bundle": {
      "dependsOn": ["@ci-hub/common#build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "@ci-hub/openclaw-plugin#bundle": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["OPENCLAW_PLUGIN_OUT_DIR"],
      "outputs": ["dist/hub-plugin.mjs"]
    },
    "desktop#bundle": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "tsc": {
      "dependsOn": ["^tsc"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"],
      "cache": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "FRONTEND_PORT",
        "CI_HUB_EXTRA_CORS_ORIGINS",
        "CI_HUB_DATA_DIR",
        "CI_HUB_APP_DATA_DIR",
        "CI_HUB_APP_DIR",
        "NODE_ENV",
        "LOCAL",
        "ROOT_FOLDER_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "POSTGRES_DBNAME",
        "POSTGRES_USERNAME",
        "RABBITMQ_HOST",
        "RABBITMQ_PORT",
        "RABBITMQ_USERNAME",
        "RABBITMQ_PASSWORD",
        "JWT_SECRET",
        "INTERNAL_IP",
        "CI_HUB_VERSION",
        "LOG_LEVEL",
        "CI_CLOUD_URL",
        "LOCAL_DOMAIN",
        "DOMAIN",
        "APPS_REPO_URL",
        "OLLAMA_URL",
        "VLLM_URL",
        "OMLX_URL",
        "OMLX_API_KEY",
        "LEMONADE_URL"
      ]
    },
    "local": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "FRONTEND_PORT",
        "CI_HUB_EXTRA_CORS_ORIGINS",
        "CI_HUB_DATA_DIR",
        "CI_HUB_APP_DATA_DIR",
        "CI_HUB_APP_DIR",
        "NODE_ENV",
        "LOCAL",
        "ROOT_FOLDER_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "POSTGRES_DBNAME",
        "POSTGRES_USERNAME",
        "RABBITMQ_HOST",
        "RABBITMQ_PORT",
        "RABBITMQ_USERNAME",
        "RABBITMQ_PASSWORD",
        "JWT_SECRET",
        "INTERNAL_IP",
        "CI_HUB_VERSION",
        "LOG_LEVEL",
        "CI_CLOUD_URL",
        "LOCAL_DOMAIN",
        "DOMAIN",
        "APPS_REPO_URL",
        "OLLAMA_URL",
        "VLLM_URL",
        "OMLX_URL",
        "OMLX_API_KEY",
        "LEMONADE_URL"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    // `test` is cached, so a test that reads a file outside its package must declare it, or turbo replays
    // a stale green after that file changes. backend: the root and desktop-resource compose files (the
    // edge, Traefik and storage guard tests), the favicon under packages/frontend/brand, and the scripts/
    // and e2e/ modules it imports. frontend: the desktop capabilities and the mobile Tauri project. Both:
    // the root tsconfig.json (backend's extends it; vite-tsconfig-paths and esbuild read it) and, for
    // frontend, the sibling packages' tsconfig.json. Found by tracing fs reads over a full run
    // (2026-10-13); add a path when a test starts reading a new one.
    "backend#test": {
      "cache": true,
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/docker-compose*.yml",
        "$TURBO_ROOT$/packages/desktop/src-tauri/resources/**",
        "$TURBO_ROOT$/packages/frontend/brand/**",
        "$TURBO_ROOT$/scripts/*.ts",
        "$TURBO_ROOT$/scripts/lib/**",
        "$TURBO_ROOT$/e2e/helpers/**",
        "$TURBO_ROOT$/e2e/mock-portal/**"
      ],
      "outputs": []
    },
    "frontend#test": {
      "cache": true,
      "dependsOn": ["^test"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/desktop/src-tauri/capabilities/**",
        "$TURBO_ROOT$/packages/mobile/src-tauri/**"
      ],
      "outputs": []
    },
    "test:coverage": {
      "cache": false,
      "dependsOn": ["^test:coverage"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^test:integration"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/"]
    }
  }
}
