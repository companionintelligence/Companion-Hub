{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "bundle": {
      "dependsOn": ["build", "^bundle"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"]
    },
    "tsc": {
      "dependsOn": ["^tsc"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "local": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "env": [
        "API_PORT",
        "TIPI_DATA_DIR",
        "TIPI_APP_DATA_DIR",
        "TIPI_APP_DIR",
        "NODE_ENV",
        "LOCAL",
        "ROOT_FOLDER_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_HOST",
        "POSTGRES_PORT",
        "POSTGRES_DBNAME",
        "POSTGRES_USERNAME",
        "RABBITMQ_HOST",
        "RABBITMQ_PORT",
        "RABBITMQ_USERNAME",
        "RABBITMQ_PASSWORD",
        "JWT_SECRET",
        "INTERNAL_IP",
        "TIPI_VERSION",
        "LOG_LEVEL",
        "RABBITMQ_USERNAME",
        "RABBITMQ_PASSWORD",
        "RABBITMQ_HOST",
        "CI_CLOUD_API_URL",
        "CI_CLOUD_FRONTEND_URL",
        "CI_CLOUD_APP_STORE_URL",
        "CI_CLOUD_URL",
        "LOCAL_DOMAIN",
        "DOMAIN",
        "APPS_REPO_URL"
      ]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^test"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^test:integration"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["coverage/"]
    }
  }
}
