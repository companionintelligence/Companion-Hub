{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion Hub",
  "mainBinaryName": "companion-hub",
  "version": "0.1.0",
  "identifier": "computer.ci.app.hub",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:9091",
    "beforeBuildCommand": "",
    "frontendDist": "../../../packages/frontend/dist/client"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/*"],
    "linux": {
      "deb": {
        "desktopTemplate": "deep-link.desktop"
      },
      "rpm": {
        "desktopTemplate": "deep-link.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 202
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 202
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Companion Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data: blob: http: https:; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5RTdCMUMyN0IzNTI1QTUKUldTbEpUVjd3ckhuQ2JvTERXYXNBdWFpM0xZdHhCZ2NaM21xOXQ0QzgvRkZQQ3hsTmdLdWJsVVkK",
      "endpoints": [
        "https://github.com/companionintelligence/CI-Hub/releases/latest/download/latest.json",
        "https://github.com/companionintelligence/CI-Hub/releases/download/nightly/latest.json"
      ]
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["cihub"]
      }
    }
  }
}
