{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Companion Hub",
  "version": "0.1.0",
  "identifier": "computer.ci.app.hub",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:9091",
    "beforeBuildCommand": "",
    "frontendDist": "../../../packages/frontend/dist/client"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Companion Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data: blob: https:; font-src 'self' data:"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "title": "Companion Hub"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5RTdCMUMyN0IzNTI1QTUKUldTbEpUVjd3ckhuQ2JvTERXYXNBdWFpM0xZdHhCZ2NaM21xOXQ0QzgvRkZQQ3hsTmdLdWJsVVkK",
      "endpoints": [
        "https://github.com/companionintelligence/CI-Hub/releases/latest/download/latest.json",
        "https://github.com/companionintelligence/CI-Hub/releases/download/nightly/latest.json"
      ]
    }
  }
}
