{
  "nodeModulesDir": "manual",
  "unstable": ["sloppy-imports"],
  "tasks": {
    "typecheck": "deno check src/index.ts",
    "test": "deno run -A npm:vitest run",
    "smoke": "deno run -A scripts/smoke-test.mjs ../src/index.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "exclude": ["dist"]
}
