  "type": {
    "$comment": "Type scale for marketing and documentation surfaces, at the 17px root. Manrope throughout (font.heading for display, titles and stat numerals). Emitted as --type-<role> (size), --type-<role>-weight, -tracking and -leading. card-title is the title of a card, panel or product tile. body.list-leading is the line height of list items in prose, a third tighter than paragraphs, with no margin between items.",
    "display": {
      "size": "clamp(2.2rem, 3.5vw + 0.5rem, 3.55rem)",
      "weight": 500,
      "tracking": "-0.025em",
      "leading": 1.04
    },
    "title": {
      "size": "clamp(1.6rem, 1.9vw + 0.55rem, 2.12rem)",
      "weight": 500,
      "tracking": "-0.02em",
      "leading": 1.12
    },
    "lede": {
      "size": "clamp(1.05rem, 0.2vw + 0.95rem, 1.12rem)",
      "weight": 400,
      "leading": 1.5
    },
    "card-title": {
      "size": "1.1rem",
      "weight": 600,
      "leading": 1.3
    },
    "body": {
      "size": "17px",
      "weight": 400,
      "leading": 1.45,
      "list-leading": 1.3
    },
    "label": {
      "size": "13px",
      "weight": 600,
      "tracking": "0.12em",
      "transform": "uppercase"
    },
    "stat": {
      "size": "clamp(2rem, 1.9vw + 1rem, 2.6rem)",
      "weight": 300,
      "tracking": "-0.03em",
      "leading": 0.95
    }
  },
  "layout": {
    "$comment": "12-column grid. The outer margins are each one column wide (content sits in columns 2 to 11), computed as one column plus one gutter. Under `breakpoint` the page is full width with the narrow gutter as margin and gap. Custom properties cannot be read in a media query, so the breakpoint is also written out literally in the generated stylesheets.",
    "columns": 12,
    "gutter": "24px",
    "gutter-narrow": "16px",
    "breakpoint": "900px"
  },
