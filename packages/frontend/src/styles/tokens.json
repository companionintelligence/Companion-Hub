    "base": "0.625rem",
    "sm": "calc(var(--radius) - 4px)",
    "md": "calc(var(--radius) - 2px)",
    "lg": "var(--radius)",
    "xl": "calc(var(--radius) + 4px)",
    "2xl": "calc(var(--radius) + 10px)",
    "control": "3px",
    "card": "5px",
    "media": "3px"
  },
  "mark": {
    "$comment": "The logo mark's three ring colours, outer to inner, on the evened ramp of the current logo (assets-mark-ramp-even): deep (the outer ring and the on-light wordmark), middle, light. Mode-independent literals; middle and light equal --aqua / --aqua-light, which follow the mark (the contract test keeps the pairs equal). The public website's theme.css still has the previous ramp (#00a9a7 / #72ddd4) until it consumes these. Deep is the brand fill for buttons and the text colour for links and labels on light grounds; light is the link and label colour on dark grounds.",
    "mark-deep": {
      "hex": "#066c80"
    },
    "mark-mid": {
      "hex": "#1fa89e"
    },
    "mark-light": {
      "hex": "#3ae7ba"
    }
  },
  "ground": {
    "$comment": "The public website's light page ground, with white panels on it. Light only: marketing and docs surfaces choose it explicitly; --background and --card are unchanged and there is no dark counterpart.",
    "cream-ground": {
      "hex": "#f7f9fa"
    }
  },
  "cta": {
    "$comment": "Accent call to action: one per view, in the role heat plays on surfaces that keep it. White text on #069b5b is 3.6:1, below AA for body-size text; it is set at weight 600 and used for button labels only, by the owner's decision (October 2026).",
    "cta": {
      "hex": "#069b5b"
    },
    "cta-foreground": {
      "hex": "#ffffff"
    },
    "cta-hover": {
      "hex": "#05824c"
    }
  },
  "button": {
    "$comment": "Primary button: a flat fill in mark-deep with white text, hover mixed 16% toward white, a soft shadow (--shadow-sm) and on hover a 1px lift with --shadow-md. No gradient, glass or blur. Mode-independent. Ghost and link roles follow the foreground and are in `roles`.",
    "button-primary": {
      "value": "var(--mark-deep)"
    },
    "button-primary-foreground": {
      "hex": "#ffffff"
    },
    "button-primary-hover": {
      "value": "color-mix(in srgb, var(--mark-deep) 84%, white)"
    },
    "button-primary-shadow": {
      "value": "var(--shadow-sm)"
    },
    "button-primary-shadow-hover": {
      "value": "var(--shadow-md)"
    },
    "button-primary-lift-hover": {
      "value": "translateY(-1px)"
    }
  },
  "roles": {
    "$comment": "Roles that depend on the ground, declared in :root and .dark so a nested .dark panel resolves them against its own --foreground. Links and labels are mark-deep on light grounds and mark-light on dark grounds, and go to the foreground colour on hover. Hairline is 12% of the foreground; the ghost button is outlined in the foreground on a transparent ground.",
    "light": {
      "link": {
        "value": "var(--mark-deep)"
      },
      "link-hover": {
        "value": "var(--foreground)"
      },
      "label-ink": {
        "value": "var(--mark-deep)"
      },
      "hairline": {
        "value": "color-mix(in srgb, var(--foreground) 12%, transparent)"
      },
