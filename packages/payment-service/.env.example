# Payment Service Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=production

# Payment Service Domain (used for OAuth issuer and redirect URLs)
PAYMENT_SERVICE_URL=https://payment.example.com

# Stripe Configuration (for card payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# X402 Crypto Payment Configuration
# See: https://www.x402.org/
X402_ENABLED=false
X402_PAYMENT_ADDRESS=

# Main App API Key (for validating service-to-service requests)
API_SECRET_KEY=

# Admin API Key (for registering OAuth clients and admin operations)
ADMIN_API_KEY=

# SQLite Database Path (relative to the container)
# This is the source of truth for:
# - User accounts
# - OAuth tokens and sessions
# - Payments and subscriptions
# - App entitlements
DATABASE_PATH=/data/payments.db

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=https://example.com,https://www.example.com

# App Store GitHub Integration
# Token with read access to the private app store repository
GITHUB_APP_STORE_TOKEN=
# Repository in format: owner/repo
GITHUB_APP_STORE_REPO=companionintelligence/CI-App-Store
# Branch to pull from
GITHUB_APP_STORE_BRANCH=main

# Payment Key Signing Secret (used for generating time-limited access keys for paid apps)
# IMPORTANT: Change this in production!
PAYMENT_KEY_SECRET=
