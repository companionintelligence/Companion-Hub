# Payment Service Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=production

# Payment Service Domain
PAYMENT_SERVICE_URL=https://payment.example.com

# Stripe Configuration (for card payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# X402 Crypto Payment Configuration
# See: https://www.x402.org/
X402_ENABLED=false
X402_PAYMENT_ADDRESS=

# Main App API Key (for validating requests from main app)
API_SECRET_KEY=

# SQLite Database Path (relative to the container)
DATABASE_PATH=/data/payments.db

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=https://example.com,https://www.example.com
