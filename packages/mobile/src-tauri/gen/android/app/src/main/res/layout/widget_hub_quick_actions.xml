<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_hub_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="none"
        android:text="@string/widget_hub_actions_header"
        android:textColor="@color/widget_hub_muted"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_hub_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hub_action"
            android:contentDescription="@string/widget_hub_open"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/widget_hub_open"
            android:textColor="@color/widget_hub_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_hub_connect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hub_action"
            android:contentDescription="@string/widget_hub_connect"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/widget_hub_connect"
            android:textColor="@color/widget_hub_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_hub_switch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hub_action"
            android:contentDescription="@string/widget_hub_switch"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/widget_hub_switch"
            android:textColor="@color/widget_hub_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_hub_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_hub_action"
            android:contentDescription="@string/widget_hub_settings"
            android:gravity="center"
            android:minHeight="48dp"
            android:text="@string/widget_hub_settings"
            android:textColor="@color/widget_hub_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
