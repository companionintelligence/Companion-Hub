  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "local": "pnpm run dev",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\" && nest build && tsx build.ts",
    "bundle": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\" && nest build && tsx build.ts",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage --watch=false run",
    "test:integration": "tsx scripts/run-integration.ts",
    "test:watch": "vitest",
    "test:db": "docker compose -f ./src/tests/db.compose.yml up -d",
    "studio": "drizzle-kit studio",
    "gen:migrations": "drizzle-kit generate",
    "gen:swagger": "nest build && node -r ./scripts/register-swagger-env.cjs dist/scripts/generate-swagger.js"
