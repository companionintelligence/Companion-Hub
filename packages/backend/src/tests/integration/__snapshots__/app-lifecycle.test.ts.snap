  "website": "https://test2.example.com",
  "force_expose": false,
  "generate_vapid_keys": false,
  "categories": [
    "utilities"
  ],
  "form_fields": [],
  "https": false,
  "exposable": true,
  "no_gui": false,
  "supported_architectures": [],
