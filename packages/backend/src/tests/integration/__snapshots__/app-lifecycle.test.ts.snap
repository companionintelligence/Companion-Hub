exports[`App lifecycle > install app > should not delete an existing app-data folder even if the app is reinstalled 1`] = `
{
  "/app-data/test/test2/app.env": "ROOT_FOLDER_HOST=/opt/ci-hub
NODE_ENV=production
DOMAIN=ci.test
LOCAL_DOMAIN=ci.lan
APP_PORT=3545
APP_URN=test2:test
APP_ID=test2-test
APP_NAME=test2
APP_STORE_ID=test
APP_DATA_DIR=/opt/ci-hub/app-data/test/test2
APP_IMAGE_TAG=1.0.0
APP_HOSTNAME=127.0.0.1
APP_INTERNAL_AUTHORITY=127.0.0.1:3545
APP_EXPOSED=false
APP_SCHEME=http
APP_PROTOCOL=http
APP_HOST=127.0.0.1
APP_DOMAIN=127.0.0.1:3545
APP_URL=http://127.0.0.1:3545
APP_BASE_URL=http://127.0.0.1:3545
APP_BASE_HOST=127.0.0.1:3545
APP_BASE_WSS_ORIGIN=ws://127.0.0.1:3545
HUB_INFERENCE_URL=http://ci-hub:3000/api/inference/v1
",
  "/app-data/test/test2/data/test.txt": "test",
  "/data/.env": "ROOT_FOLDER_HOST=/opt/ci-hub",
  "/data/apps/test/test2/config.json": "{
  "id": "test2",
  "urn": "test2:test",
  "available": true,
  "deprecated": false,
  "port": 3545,
  "name": "test2 app",
  "description": "Description for test2",
  "version": "1.0.0",
  "cihub_app_version": 1,
  "short_desc": "Short description for test2",
  "replaces": [],
  "author": "test-author",
  "source": "https://example.com/test2",
  "website": "https://test2.example.com",
  "force_expose": false,
  "generate_vapid_keys": false,
  "categories": [
    "utilities"
  ],
  "form_fields": [],
  "https": false,
  "exposable": true,
  "no_gui": false,
  "supported_architectures": [],
  "dynamic_config": true,
  "created_at": 1769810550000,
  "updated_at": 1769810550000,
  "force_pull": false
}",
  "/data/apps/test/test2/data": null,
  "/data/apps/test/test2/docker-compose.json": "{
  "schemaVersion": 2,
  "services": [
    {
      "name": "test2",
      "image": "nginx:latest",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "TEST",
          "value": "test"
        }
      ]
    }
  ]
}",
  "/data/apps/test/test2/docker-compose.yml": "services:
  test2:
    image: nginx:latest
    restart: unless-stopped
    networks:
      test2_test_network:
        gw_priority: 0
      ci-hub_network:
        gw_priority: 1
      ci-os-hub_network:
        gw_priority: 0
    environment:
      TEST: test
    ports:
      - \${APP_PORT}:80
    labels:
      ci-hub.managed: true
      ci-hub.appurn: test2:test
      ci-os-hub.managed: true
      ci-os-hub.appurn: test2:test
    env_file:
      - /app-data/test/test2/app.env
networks:
  ci-hub_network:
    name: ci-hub_network
    external: true
  ci-os-hub_network:
    name: ci-os-hub_network
    external: true
  test2_test_network:
    name: test2_test_network
    external: false
    ipam:
      config:
        - subnet: 10.128.X.0/24

",
  "/data/apps/test/test2/metadata/description.md": "test",
  "/data/backups": null,
  "/data/repos/test/apps/test2/config.json": "{
