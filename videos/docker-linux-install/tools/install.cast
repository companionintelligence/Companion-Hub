[12.9063, "o", "\u001b[7m# Add Docker's official GPG key:\u001b[27m\r\n\r\u001b[7msudo apt update\u001b[27m\r\n\r\u001b[7msudo apt install ca-certificates curl\u001b[27m\r\n\r\u001b[7msudo install -m 0755 -d /etc/apt/keyrings\u001b[27m\r\n\r\u001b[7msudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc\u001b[27m \r\n\r\u001b[7msudo chmod a+r /etc/apt/keyrings/docker.asc\u001b[27m\r\n\r\n\r\u001b[7m# Add the repository to Apt sources:\u001b[27m\r\n\r\u001b[7msudo tee /etc/apt/sources.list.d/docker.sources <<EOF\u001b[27m\r\n\r\u001b[7mTypes: deb\u001b[27m\r\n\r\u001b[7mURIs: https://download.docker.com/linux/ubuntu\u001b[27m\r\n\r\u001b[7mSuites: $(. /etc/os-release && echo \"${UBUNTU_CODENAME:-$VERSION_CODENAME}\")\u001b[27m\r\n\r\u001b[7mComponents: stable\u001b[27m\r\n\r\u001b[7mArchitectures: $(dpkg --print-architecture)\u001b[27m\r\n\r\u001b[7mSigned-By: /etc/apt/keyrings/docker.asc\u001b[27m\r\n\r\u001b[7mEOF\u001b[27m\r\n\r\n\r\u001b[7msudo apt update\u001b[27m"]
[13.9059, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\b\b# Add Docker's official GPG key:\r\n\rsudo apt update\r\n\rsudo apt install ca-certificates curl\r\n\rsudo install -m 0755 -d /etc/apt/keyrings\r\n\rsudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \r\n\rsudo chmod a+r /etc/apt/keyrings/docker.asc\r\n\r\n\r# Add the repository to Apt sources:\r\n\rsudo tee /etc/apt/sources.list.d/docker.sources <<EOF\r\n\rTypes: deb\r\n\rURIs: https://download.docker.com/linux/ubuntu\r\n\rSuites: $(. /etc/os-release && echo \"${UBUNTU_CODENAME:-$VERSION_CODENAME}\")\r\n\rComponents: stable\r\n\rArchitectures: $(dpkg --print-architecture)\r\n\rSigned-By: /etc/apt/keyrings/docker.asc\r\n\rEOF\r\n\r\n\rsudo apt update\r\n\u001b[?2004l\r"]
