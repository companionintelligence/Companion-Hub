[0.0773, "o", "\u001b[?2004h\u001b]0;ci@ubuntu: ~\u0007\u001b[01;32mci@ubuntu\u001b[00m:\u001b[01;34m~\u001b[00m$ "]
[1.3007, "m", "install"]
[1.303, "o", "\u001b[7mcurl -fsSL https://get.docker.com | sh\u001b[27m"]
[2.3029, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bcurl -fsSL https://get.docker.com | sh\r\n\u001b[?2004l\r"]
[2.5867, "o", "# Executing docker install script, commit: 2b32480025b223ebfddae9a3a8bef09027680f53\r\n"]
[2.5969, "o", "+ sudo -E sh -c apt-get -qq update >/dev/null\r\n"]
[2.6047, "o", "[sudo] password for ci: "]
[4.572, "o", "\r\n"]
[8.7997, "o", "+ sudo -E sh -c DEBIAN_FRONTEND=noninteractive apt-get -y -qq install ca-certificates curl >/dev/null\r\n"]
[10.6092, "o", "+ sudo -E sh -c install -m 0755 -d /etc/apt/keyrings\r\n"]
[10.6218, "o", "+ sudo -E sh -c curl -fsSL \"https://download.docker.com/linux/ubuntu/gpg\" -o /etc/apt/keyrings/docker.asc\r\n"]
[10.9421, "o", "+ sudo -E sh -c chmod a+r /etc/apt/keyrings/docker.asc\r\n"]
[10.9533, "o", "+ sudo -E sh -c echo \"deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable\" > /etc/apt/sources.list.d/docker.list\r\n"]
[10.9616, "o", "+ sudo -E sh -c apt-get -qq update >/dev/null\r\n"]
[12.6094, "o", "+ apt_flags=-y -qq\r\n+ [ -n  ]\r\n+ sudo -E sh -c DEBIAN_FRONTEND=noninteractive apt-get -y -qq install docker-ce docker-ce-cli containerd.io docker-compose-plugin docker-ce-rootless-extras docker-buildx-plugin docker-model-plugin >/dev/null\r\n"]
[26.9033, "o", "Using systemd to manage Docker service\r\n+ sudo -E sh -c systemctl enable --now docker.service 2>/dev/null\r\n"]
[27.1954, "o", "INFO: Docker daemon enabled and started\r\n\r\n+ sudo -E sh -c docker version\r\n"]
