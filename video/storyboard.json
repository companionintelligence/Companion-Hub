{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-hub",
    "name": "Companion Hub",
    "repo": "companionintelligence/CI-Hub",
    "marketplaceId": "ci-hub",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5
  },
  "chapters": {
    "claim": "Claim the machine",
    "setup": "First boot",
    "run": "Day to day",
    "extend": "Make it yours",
    "dials": "Under the hood"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "open",
      "kind": "intro",
      "seconds": 4.5,
      "title": "Companion Hub",
      "caption": "Your data. Your hardware. Your AI.",
      "narration": "Companion Hub is the app runtime that lives in your house."
    },
    {
      "id": "sign-in",
      "kind": "screen",
      "chapter": "claim",
      "seconds": 5,
      "caption": "A local admin account. Companion Portal is optional.",
      "narration": "It opens on a local login. Companion Portal sign-in is optional.",
      "shots": [
        {
          "id": "login-screen",
          "url": "hub.ci.lan/login",
          "alt": "The Hub login form: a CI Account button above the local email and password fields.",
          "motion": "push-in",
          "capture": {
            "path": "/login",
            "waitUntil": "domcontentloaded",
            "waitFor": "input[placeholder='you@example.com']",
            "settle": 900
          }
        }
      ]
    },
    {
      "id": "pair-the-hub",
      "kind": "screen",
      "chapter": "claim",
      "seconds": 5,
      "caption": "Six characters, and the machine is yours.",
      "narration": "A new Hub asks for one pairing code from Companion Portal.",
      "shots": [
        {
          "id": "device-registration",
          "url": "hub.ci.lan/device-registration",
          "alt": "Step 2: Connect this device, with the pairing-code field waiting for six characters.",
          "motion": "push-in",
          "capture": {
            "path": "/device-registration",
            "waitUntil": "domcontentloaded",
            "waitFor": "input[placeholder='ABC123']",
            "settle": 900,
            "mask": ["text=Device ID"]
          }
        }
      ]
    },
    {
      "id": "first-boot",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5.5,
      "caption": "Local models, network, apps. Then Install & Finish.",
      "narration": "First boot is one pass. Local models, network, apps.",
      "shots": [
        {
          "id": "onboarding-wizard",
          "url": "hub.ci.lan/onboarding",
          "alt": "The Set Up Your Hub wizard with its sticky Install and Finish footer.",
          "motion": "drift-down",
          "capture": {
            "path": "/onboarding",
            "waitUntil": "domcontentloaded",
            "waitFor": "input[placeholder='you@example.com']",
            "before": [
              { "fill": ["input[placeholder='you@example.com']", "test@test.com"] },
              { "fill": ["input[placeholder='Enter your password']", "password"] },
              { "click": "button[type='submit']" },
              { "waitFor": "[data-testid='finish-setup-btn']" },
              { "wait": 1500 }
            ],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "home-dashboard",
      "kind": "screen",
      "chapter": "run",
      "seconds": 5.5,
      "caption": "Disk, CPU, memory. From a box you can point at.",
      "narration": "This is home. Disk, CPU and memory, read off hardware you own.",
      "shots": [
        {
          "id": "hub-home",
          "url": "hub.ci.lan/home",
          "alt": "The Hub dashboard: three system stat cards above the installed-apps row.",
          "motion": "push-in",
          "capture": {
            "path": "/login",
            "waitUntil": "domcontentloaded",
            "waitFor": "input[placeholder='you@example.com']",
            "before": [
              { "fill": ["input[placeholder='you@example.com']", "test@test.com"] },
              { "fill": ["input[placeholder='Enter your password']", "password"] },
              { "click": "button[type='submit']" },
              { "waitFor": "text=Disk space" },
              { "wait": 1500 }
            ],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "browse-the-store",
      "kind": "screen",
      "chapter": "run",
      "seconds": 5.5,
      "caption": "The App Store, fed by the open Hub market.",
      "narration": "The store is fed by the open Hub market. Search, or browse.",
      "shots": [
        {
          "id": "hub-store",
          "url": "hub.ci.lan/store",
          "alt": "The Hub App Store grid, with the category sidebar and the search field.",
          "motion": "drift-down",
          "capture": {
            "path": "/store",
            "waitUntil": "domcontentloaded",
            "waitFor": "a[href^='/store/']",
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "open-alternatives",
      "kind": "screen",
      "chapter": "run",
      "seconds": 6,
      "caption": "Alternatives: the app you rent, and the one you own.",
      "narration": "For the software you rent, the store names the open replacement you can own.",
      "shots": [
        {
          "id": "store-alternatives",
          "url": "hub.ci.lan/store",
          "alt": "The store's Alternatives view: a table pairing proprietary products with the open source apps that replace them.",
          "motion": "drift-down",
          "capture": {
            "path": "/store?category=alternatives",
            "waitUntil": "domcontentloaded",
            "waitFor": "text=Open source replacements for proprietary software",
            "before": [{ "waitFor": "table tbody tr" }, { "wait": 800 }],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "app-privacy",
      "kind": "screen",
      "chapter": "run",
      "seconds": 5,
      "caption": "App Privacy, on every single app page.",
      "narration": "Every app page carries an App Privacy card. It is a short read.",
      "shots": [
        {
          "id": "app-details",
          "url": "hub.ci.lan/store",
          "alt": "An app detail page scrolled to the App Privacy card, beside the Information panel.",
          "motion": "push-in",
          "capture": {
            "path": "/store",
            "waitUntil": "domcontentloaded",
            "waitFor": "a[href^='/store/']",
            "before": [
              { "click": "a[href^='/store/']" },
              { "waitFor": "[data-testid='app-header-actions-row']" },
              { "wait": 1500 },
              { "hover": "text=App Privacy" },
              { "wait": 600 }
            ],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "configure-install",
      "kind": "screen",
      "chapter": "run",
      "seconds": 6.5,
      "caption": "Ports, paths and secrets, shown before anything runs.",
      "narration": "You see every port, path and secret an app wants before it ever runs.",
      "shots": [
        {
          "id": "install-dialog",
          "url": "hub.ci.lan/store",
          "alt": "The install dialog open over an app page, listing the ports, paths and settings the app is asking for.",
          "motion": "push-in",
          "capture": {
            "path": "/store",
            "waitUntil": "domcontentloaded",
            "waitFor": "a[href^='/store/']",
            "before": [
              { "click": "a[href^='/store/']" },
              { "waitFor": "[data-testid='action-install']" },
              { "click": "[data-testid='action-install']" },
              { "waitFor": "[role='dialog']" },
              { "wait": 1200 }
            ],
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "install-and-run",
      "kind": "screen",
      "chapter": "run",
      "seconds": 5,
      "caption": "Installing, then running. That is the whole ceremony.",
      "narration": "Install it, and the Hub works until that badge turns green.",
      "shots": [
        {
          "id": "running-app",
          "url": "hub.ci.lan/apps/immich",
          "alt": "An installed app on the Hub: a running status pill beside Open, Stop and Restart.",
          "motion": "push-in",
          "capture": {
            "path": "/apps/ci-marketplace/immich",
            "waitUntil": "domcontentloaded",
            "waitFor": "[data-testid='app-status-pill']",
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "bring-your-own-app",
      "kind": "screen",
      "chapter": "extend",
      "seconds": 6,
      "caption": "Bring your own containers. They become a real app.",
      "narration": "Your own containers become a first class app, with a name and an address.",
      "shots": [
        {
          "id": "custom-app-create",
          "url": "hub.ci.lan/apps/create",
          "alt": "The custom app form: an App Name field above the multi-service Docker Compose editor.",
          "motion": "drift-down",
          "capture": {
            "path": "/apps/create",
            "waitUntil": "domcontentloaded",
            "waitFor": "input[placeholder='Enter a unique name for your app']",
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "expose-a-port",
      "kind": "screen",
      "chapter": "extend",
      "seconds": 6.5,
      "caption": "This device, your private VPN, or the public web.",
      "narration": "Anything already running here gets a name, a certificate, and a door you choose.",
      "shots": [
        {
          "id": "port-expose",
          "url": "hub.ci.lan/apps/expose",
          "alt": "The Expose a port form, with the three exposure modes: this device, private VPN, or public web.",
          "motion": "push-in",
          "capture": {
            "path": "/apps/expose",
            "waitUntil": "domcontentloaded",
            "waitFor": "text=Publish a service already running on this Hub",
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "local-models",
      "kind": "screen",
      "chapter": "dials",
      "seconds": 6,
      "caption": "The Hub reads the hardware, then picks the models.",
      "narration": "The Hub reads your hardware and picks models it can actually run at home.",
      "shots": [
        {
          "id": "ai-hardware",
          "url": "hub.ci.lan/settings",
          "alt": "The AI tab's hardware card: CPU, RAM, GPU, VRAM and storage, with a capability tier badge.",
          "motion": "push-in",
          "capture": {
            "path": "/settings?tab=ai",
            "waitUntil": "domcontentloaded",
            "waitFor": "[data-testid='hw-card-title']",
            "before": [{ "waitFor": "[data-testid='tier-badge']" }, { "wait": 800 }],
            "settle": 1500
          }
        }
      ]
    },
    {
      "id": "own-your-agents",
      "kind": "screen",
      "chapter": "dials",
      "seconds": 6,
      "caption": "MCP tools you can read. Keys you issue, scoped.",
      "narration": "Agents drive your Hub through tools you can read, scoped by keys you issue.",
      "shots": [
        {
          "id": "mcp-tools",
          "url": "hub.ci.lan/settings",
          "alt": "The MCP tab: server status, the active key count, and the searchable catalog of tools the Hub publishes.",
          "motion": "drift-down",
          "capture": {
            "path": "/settings?tab=mcp",
            "waitUntil": "domcontentloaded",
            "waitFor": "[data-testid='mcp-settings']",
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "every-dial",
      "kind": "screen",
      "chapter": "dials",
      "seconds": 5.5,
      "caption": "Security, network, app stores, AI, logs.",
      "narration": "Want the dials? They are all here. Reading your own logs costs nothing.",
      "shots": [
        {
          "id": "hub-settings",
          "url": "hub.ci.lan/settings",
          "alt": "Hub settings with its tab row: Settings, Security, App Stores, Network, AI, MCP, System, Logs.",
          "motion": "push-in",
          "capture": {
            "path": "/settings",
            "waitUntil": "domcontentloaded",
            "waitFor": "[data-testid='settings-scroll-container']",
            "settle": 1200
          }
        },
        {
          "id": "hub-settings-security",
          "url": "hub.ci.lan/settings",
          "alt": "The Security tab of Hub settings.",
          "motion": "push-in",
          "capture": {
            "path": "/settings?tab=security",
            "waitUntil": "domcontentloaded",
            "waitFor": "[data-testid='settings-scroll-container']",
            "settle": 1200
          }
        }
      ]
    },
    {
      "id": "resource-monitor",
      "kind": "screen",
      "chapter": "dials",
      "seconds": 4.5,
      "caption": "Per-app CPU and memory, sampled live.",
      "narration": "Resource Monitor charts CPU and memory.",
      "shots": [
        {
          "id": "hub-resource-monitor",
          "url": "hub.ci.lan/resource-monitor",
          "alt": "The Resource Monitor: workload summary cards above the per-app table.",
          "motion": "drift-down",
          "capture": {
            "path": "/resource-monitor",
            "waitUntil": "domcontentloaded",
            "waitFor": "text=Resource Monitor",
            "settle": 1200,
            "mask": ["text=Last sampled"]
          }
        }
      ]
    },
    {
      "id": "recap",
      "kind": "feature",
      "seconds": 5,
      "caption": "Your hardware. Your domain. Your data.",
      "narration": "Your hardware, your domain, your data. Nothing to cancel.",
      "items": [
        { "label": "Hardware", "value": "Yours" },
        { "label": "Domain", "value": "Yours" },
        { "label": "Data", "value": "Stays home" },
        { "label": "Subscriptions", "value": "None" }
      ]
    },
    {
      "id": "close",
      "kind": "outro",
      "seconds": 4.5,
      "caption": "ci.computer",
      "cta": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "Companion Intelligence. UnCloud your life."
    }
  ]
}
