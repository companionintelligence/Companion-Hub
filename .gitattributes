# The desktop app compiles these Traefik seeds into its binary and writes them where the Hub has
# not written its own yet. Keep them LF, as the Hub writes them, in Windows checkouts too, where
# core.autocrlf would otherwise ship them with CRLF.
packages/backend/assets/traefik/traefik.yml text eol=lf
packages/backend/assets/traefik/dynamic/dynamic.yml text eol=lf
