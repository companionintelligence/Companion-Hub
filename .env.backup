# Production Environment Configuration
LOG_LEVEL=info
NODE_ENV=production

# Cloudflare Tunnel Configuration
CLOUDFLARE_API_TOKEN=your-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_TUNNEL_ID=your-tunnel-id-here
CLOUDFLARE_ZONE_ID=a3d2a463ae7be7d40b81b22e80790feb

# Platform Variables for Mac
PLATFORM=mac
DOCKER_PLATFORM=linux/arm64
TARGETARCH=arm64
ROOT_FOLDER_HOST=$HOME/Development/companion/CI-OS-Hub/.internal
INTERNAL_IP=127.0.0.1
RUNTIPI_APP_DATA_PATH=.internal

# Platform Variables for Linux
# PLATFORM=linux
# DOCKER_PLATFORM=linux/amd64
# TARGETARCH=amd64
# ROOT_FOLDER_HOST=/opt/ci-os-hub/.internal
# INTERNAL_IP=0.0.0.0
# RUNTIPI_APP_DATA_PATH=/opt/ci-os-hub/.internal

# Apps Repository Configuration
APPS_REPO_ID=29ca930bfdaffa1dfabf5726336380ede7066bc53297e3c0c868b27c97282903
APPS_REPO_URL=https://github.com/runtipi/runtipi-appstore

# System Configuration
TZ=UTC
DNS_IP=9.9.9.9
ARCHITECTURE=arm64

# Security - CHANGE THESE IN PRODUCTION!
JWT_SECRET=857ad2225d62961ba24b12ee88b4a628e1647a0c61d5113f313f56f22461d0c3

# Domain Configuration
DOMAIN=example.com
LOCAL_DOMAIN=companionintel.com

# Database Configuration
# IMPORTANT: POSTGRES_PORT=5432 (container port, NOT 5000)
# The app connects to ci-os-hub-db:5432 internally
# Port 5000 is only the host port mapping
POSTGRES_HOST=ci-os-hub-db
POSTGRES_DBNAME=tipi
POSTGRES_USERNAME=tipi
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# RabbitMQ Configuration
RABBITMQ_HOST=ci-os-hub-queue
RABBITMQ_USERNAME=tipi
RABBITMQ_PASSWORD=tipi

# CI-OS-Hub Configuration
RUNTIPI_FORWARD_AUTH_URL=http://ci-os-hub:3000/api/auth/traefik

# Feature Flags
DEMO_MODE=false
GUEST_DASHBOARD=false
ALLOW_AUTO_THEMES=true
ALLOW_ERROR_MONITORING=true
PERSIST_TRAEFIK_CONFIG=true
QUEUE_TIMEOUT_IN_MINUTES=5
MAX_BACKUPS=10
ADVANCED_SETTINGS=true
EXPERIMENTAL_INSECURE_COOKIE=false

# Theme Configuration
THEME_BASE=stone
THEME_COLOR=teal

# Version
TIPI_VERSION=4.5.0
LOCAL=false
